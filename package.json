{
  "name": "vaelro-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "capture:work": "tsx scripts/capture-work.ts",
    "preview": "vite preview",
    "predeploy": "tsc --noEmit && vite build --base=/vaelro-website/ && cp dist/index.html dist/404.html && touch dist/.nojekyll",
    "deploy": "gh-pages -d dist --dotfiles",
    "test:workshop": "tsx scripts/test-workshop.ts",
    "prepare:portraits": "tsx scripts/prepare-portraits.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.0",
    "framer-motion": "^12.42.2",
    "lenis": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/sora": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
